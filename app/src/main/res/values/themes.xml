<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 应用基底主题：Material3 + 语义色 token 绑定 -->
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>

        <item name="android:colorBackground">@color/surface_page</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceSunken">@color/surface_sunken</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/surface_outline</item>
        <item name="colorError">@color/feedback_error</item>

        <item name="colorTextPrimary">@color/text_primary</item>
        <item name="colorTextSecondary">@color/text_secondary</item>
        <item name="colorTextTertiary">@color/text_tertiary</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- 状态栏与底栏跟随页面背景，避免色块割裂 -->
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
    </style>

    <!-- 浅色默认主题：状态栏图标使用深色 -->
    <style name="AppTheme" parent="Base.AppTheme">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- ===== 经典单色系 (Light) ===== -->

    <style name="AppTheme.Purple" parent="AppTheme">
        <item name="colorPrimary">@color/theme_purple_primary</item>
        <item name="colorPrimaryContainer">@color/theme_purple_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_purple_on_container</item>
    </style>

    <style name="AppTheme.Blue" parent="AppTheme">
        <item name="colorPrimary">@color/theme_blue_primary</item>
        <item name="colorPrimaryContainer">@color/theme_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_blue_on_container</item>
    </style>

    <style name="AppTheme.Green" parent="AppTheme">
        <item name="colorPrimary">@color/theme_green_primary</item>
        <item name="colorPrimaryContainer">@color/theme_green_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_green_on_container</item>
    </style>

    <style name="AppTheme.Orange" parent="AppTheme">
        <item name="colorPrimary">@color/theme_orange_primary</item>
        <item name="colorPrimaryContainer">@color/theme_orange_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_orange_on_container</item>
    </style>

    <style name="AppTheme.Pink" parent="AppTheme">
        <item name="colorPrimary">@color/theme_pink_primary</item>
        <item name="colorPrimaryContainer">@color/theme_pink_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_pink_on_container</item>
    </style>

    <!-- ===== 暗黑与纯黑系 (Dark / OLED) ===== -->

    <!-- 深邃暗夜 (Midnight Dark) -->
    <style name="AppTheme.Dark" parent="Base.AppTheme">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:colorBackground">#121216</item>
        <item name="colorSurface">#1E1B26</item>
        <item name="colorSurfaceSunken">#272332</item>
        <item name="colorOutline">#3D384C</item>
        <item name="colorTextPrimary">#F3F4F6</item>
        <item name="colorTextSecondary">#C9C3D8</item>
        <item name="colorTextTertiary">#8F88A2</item>
        <item name="android:textColorPrimary">#F3F4F6</item>
        <item name="android:textColorSecondary">#C9C3D8</item>
        <item name="colorPrimary">#A78BFA</item>
        <item name="colorOnPrimary">#1E1B4B</item>
        <item name="colorPrimaryContainer">#2E234E</item>
        <item name="colorOnPrimaryContainer">#E4E0FF</item>
        <item name="colorSecondary">#38BDF8</item>
        <item name="colorSecondaryContainer">#0C4A6E</item>
        <item name="android:statusBarColor">#121216</item>
        <item name="android:navigationBarColor">#121216</item>
    </style>

    <!-- 极致纯黑 (OLED Pure Black: 纯黑底 + 高对比荧光绿) -->
    <style name="AppTheme.Oled" parent="Base.AppTheme">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#0A0A0A</item>
        <item name="colorSurfaceSunken">#141414</item>
        <item name="colorOutline">#262626</item>
        <item name="colorTextPrimary">#FFFFFF</item>
        <item name="colorTextSecondary">#A3A3A3</item>
        <item name="colorTextTertiary">#737373</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#A3A3A3</item>
        <item name="colorPrimary">#10B981</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#064E3B</item>
        <item name="colorOnPrimaryContainer">#A7F3D0</item>
        <item name="colorSecondary">#06B6D4</item>
        <item name="colorSecondaryContainer">#164E63</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- ===== 双拼撞色 / 高对比系 ===== -->

    <!-- 赛博朋克 (Cyberpunk: 霓虹粉 + 赛博青 + 深蓝夜景) -->
    <style name="AppTheme.Cyberpunk" parent="Base.AppTheme">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:colorBackground">#0B0F19</item>
        <item name="colorSurface">#151C2C</item>
        <item name="colorSurfaceSunken">#1E293B</item>
        <item name="colorOutline">#334155</item>
        <item name="colorTextPrimary">#F8FAFC</item>
        <item name="colorTextSecondary">#94A3B8</item>
        <item name="colorTextTertiary">#64748B</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="colorPrimary">#F43F5E</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#881337</item>
        <item name="colorOnPrimaryContainer">#FFE4E6</item>
        <item name="colorSecondary">#06B6D4</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSecondaryContainer">#155E75</item>
        <item name="colorOnSecondaryContainer">#CFFAFE</item>
        <item name="android:statusBarColor">#0B0F19</item>
        <item name="android:navigationBarColor">#0B0F19</item>
    </style>

    <!-- 黑金奢华 (Black & Gold: 曜石黑 + 璀璨金) -->
    <style name="AppTheme.BlackGold" parent="Base.AppTheme">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:colorBackground">#09090B</item>
        <item name="colorSurface">#18181B</item>
        <item name="colorSurfaceSunken">#27272A</item>
        <item name="colorOutline">#3F3F46</item>
        <item name="colorTextPrimary">#FAFAFA</item>
        <item name="colorTextSecondary">#A1A1AA</item>
        <item name="colorTextTertiary">#71717A</item>
        <item name="android:textColorPrimary">#FAFAFA</item>
        <item name="android:textColorSecondary">#A1A1AA</item>
        <item name="colorPrimary">#F59E0B</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#451A03</item>
        <item name="colorOnPrimaryContainer">#FEF3C7</item>
        <item name="colorSecondary">#FBBF24</item>
        <item name="android:statusBarColor">#09090B</item>
        <item name="android:navigationBarColor">#09090B</item>
    </style>

    <!-- 暮色黄昏 (Twilight: 暮夜紫 + 暖阳橙) -->
    <style name="AppTheme.Twilight" parent="AppTheme">
        <item name="colorPrimary">#7C3AED</item>
        <item name="colorPrimaryContainer">#EDE9FE</item>
        <item name="colorOnPrimaryContainer">#4C1D95</item>
        <item name="colorSecondary">#EA580C</item>
        <item name="colorSecondaryContainer">#FFEDD5</item>
    </style>

    <!-- 冰与火 (Ice & Fire: 炽火红 + 寒冰蓝) -->
    <style name="AppTheme.IceFire" parent="AppTheme">
        <item name="colorPrimary">#EF4444</item>
        <item name="colorPrimaryContainer">#FEE2E2</item>
        <item name="colorOnPrimaryContainer">#7F1D1D</item>
        <item name="colorSecondary">#0284C7</item>
        <item name="colorSecondaryContainer">#E0F2FE</item>
    </style>

    <!-- ============ 文本样式（统一字号阶梯 12/13/15/20，行高 1.5） ============ -->

    <style name="Text.Title" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Text.SectionLabel" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorTextTertiary</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <!-- ============ 卡片容器（统一圆角 + 描边，替代原来的半透明黑块） ============ -->

    <style name="CardSection" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- ============ 按钮（Material3 语义化，触摸目标 ≥48dp） ============ -->

    <style name="Btn.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Btn.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Btn.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">14dp</item>
    </style>

</resources>
