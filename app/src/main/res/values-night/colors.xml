<?xml version="1.0" encoding="utf-8"?>
<!--
  语义色 token（深色模式）。
  注意：不是简单反色 —— 品牌色改用低饱和/提亮的色调变体，
  状态色单独调亮以在深色表面上仍满足 4.5:1。
-->
<resources>

    <!-- ===== 品牌主色 ===== -->
    <color name="brand_primary">#C6BFFF</color>
    <color name="brand_on_primary">#2A1A8C</color>
    <color name="brand_primary_container">#413397</color>
    <color name="brand_on_primary_container">#E4E0FF</color>

    <!-- ===== 辅助色 ===== -->
    <color name="brand_secondary">#7FD8CC</color>
    <color name="brand_on_secondary">#00382F</color>
    <color name="brand_secondary_container">#005046</color>
    <color name="brand_on_secondary_container">#C8F3EC</color>

    <!-- ===== 表面层级 ===== -->
    <color name="surface_page">#131118</color>
    <color name="surface_card">#1E1B26</color>
    <color name="surface_sunken">#282433</color>
    <color name="surface_outline">#494455</color>

    <!-- ===== 文字层级 ===== -->
    <color name="text_primary">#E7E1F4</color>
    <color name="text_secondary">#C9C3D8</color>
    <color name="text_tertiary">#9A93AC</color>

    <!-- ===== 语义反馈色 ===== -->
    <color name="feedback_success">#6FDBC6</color>
    <color name="feedback_warning">#F5B860</color>
    <color name="feedback_error">#F2B8B5</color>

    <!-- ===== 桌宠状态色 ===== -->
    <color name="state_unknown">#9A93AC</color>
    <color name="state_idle">#9A93AC</color>
    <color name="state_working">#F5B860</color>
    <color name="state_thinking">#8AC0FF</color>
    <color name="state_responding">#84DC94</color>
    <color name="state_tool">#FFB68F</color>
    <color name="state_waiting">#FFB68F</color>
    <color name="state_error">#F2B8B5</color>

    <!-- ===== 悬浮窗状态卡（与浅色模式一致，本身就是深色卡） ===== -->
    <color name="overlay_card_bg">#F2242232</color>
    <color name="overlay_text_primary">#FFFFFF</color>
    <color name="overlay_text_secondary">#B5B0C4</color>

    <!-- 悬浮窗状态色与浅色模式相同（卡片本身恒为深色，无需切换） -->
