    <color name="overlay_state_idle">#9A93AC</color>
    <color name="overlay_state_working">#F5B860</color>
    <color name="overlay_state_thinking">#8AC0FF</color>
    <color name="overlay_state_responding">#84DC94</color>
    <color name="overlay_state_tool">#FFB68F</color>
    <color name="overlay_state_waiting">#FFB68F</color>
    <color name="overlay_state_error">#F2B8B5</color>

