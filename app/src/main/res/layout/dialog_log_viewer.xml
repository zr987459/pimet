<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161B22"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <!-- 顶部标题与关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📜 系统运行与部署日志"
            android:textColor="#F0F6FC"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logViewerClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#8B949E"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 日志源切换按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLogTerminal"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:text="🖥️ 控制台"
            android:textColor="@color/brand_on_primary_container"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/btnLogClawBench"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_normal"
            android:text="🦞 ClawBench"
            android:textColor="#C9D1D9"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/btnLogPiWeb"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_normal"
            android:text="🌐 Pi-Web"
            android:textColor="#C9D1D9"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- 日志内容滚动查看区 -->
    <ScrollView
        android:id="@+id/logViewerScrollView"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="@dimen/space_md"
        android:background="#0D1117"
        android:padding="@dimen/space_sm">

        <TextView
            android:id="@+id/logViewerContentTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:text="正在加载日志..."
            android:textColor="#C9D1D9"
            android:textSize="11sp"
            android:typeface="monospace" />
    </ScrollView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLogRefresh"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_height_compact"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="?attr/selectableItemBackground"
            android:text="🔄 刷新"
            android:textColor="#58A6FF"
            android:textSize="@dimen/text_small" />

        <Button
            android:id="@+id/btnLogClear"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_height_compact"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="?attr/selectableItemBackground"
            android:text="🗑️ 清空"
            android:textColor="#F85149"
            android:textSize="@dimen/text_small" />

        <Button
            android:id="@+id/btnLogCopy"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_height_compact"
            android:background="@drawable/bg_tab_selected"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:text="📋 复制全部"
            android:textColor="@color/brand_on_primary_container"
            android:textSize="@dimen/text_small"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
